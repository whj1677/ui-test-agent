{
  "name": "deepseek-ui-test-agent",
  "version": "0.4.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.integration.mjs",
    "test:console": "node tests/console.integration.mjs",
    "test:model-flow": "node tests/model-flow.integration.mjs",
    "test:reliability": "node tests/reliability.integration.mjs",
    "test:discovery": "node tests/discovery.integration.mjs",
    "test:optimization": "node optimization/evaluate.mjs fixtures",
    "format": "prettier --write \"src/**/*.mjs\" \"public/*.js\" \"tests/*.mjs\" \"optimization/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"public/*.js\" \"tests/*.mjs\" \"optimization/*.mjs\""
  },
  "dependencies": {
    "acorn": "8.15.0",
    "playwright": "1.62.1",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
