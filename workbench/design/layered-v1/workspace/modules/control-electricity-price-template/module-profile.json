  "fingerprint": {
    "value": null,
    "note": "由 probe-module 任务写入：目标页关键 DOM 结构摘要（不含业务数据）。为 null 表示尚未标定。",
    "captured_at": null
  },
  "calibration": {
    "web.visibility": null,
