{
  "name": "ui-test-approved-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-workbench.ps1",
    "start:trial-site": "node trial-site/server.mjs",
    "start:auth-fixture": "node auth-fixture/server.mjs",
    "self-check:trial-site": "playwright test --config trial-site/reference/playwright.config.mjs",
    "register:approved": "node server/register-approved.mjs",
    "register:reviewed": "node server/register-reviewed-asset.mjs",
    "authorize:m2c-revalidation": "node server/register-m2c-revalidation.mjs",
    "authorize:m2c-wait-fix-validation": "node server/register-m2c-wait-fix-validation.mjs",
    "test": "node scripts/run-unit-checks.mjs",
    "test:official": "node scripts/verify-official-workbench.mjs",
    "revalidate:m2c-runtime-fix": "node server/revalidate-m2c-runtime-fix.mjs",
    "register:m2c-runtime-revalidation": "node server/register-m2c-runtime-revalidation.mjs",
    "lab": "node ../heldout-lab/serve.mjs 4198",
    "generate:case-template": "node scripts/generate-case-template.mjs",
    "generate:hold-q1-package": "node scripts/generate-hold-q1-case-package.mjs",
    "generate:ui-d2a-samples": "node scripts/generate-ui-d2a-samples.mjs",
    "generate:ui-d2a-native-sample": "node scripts/generate-ui-d2a-native-sample.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.62.1",
    "exceljs": "4.4.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
