        "title": "西站检修设备组合查询（入口 /ui/a）",
        "module": "设备台账 / 组合查询",
        "preconditions": "已启动 TEST-SITE-01；设备固定数据为 DEV-001 至 DEV-006；当前入口可访问。",
        "test_data": "站点=西站\n状态=检修\n排序=设备编号升序\n入口=http://127.0.0.1:4320/ui/a",
        "steps": [
          {
            "order": 1,
            "action": "S01 打开指定入口，查看初始设备列表",
            "expected": "显示“共6条”，按 DEV-001 至 DEV-006 升序展示"
          },
          {
            "order": 2,
            "action": "S02 选择“西站”和“检修”，暂不点击查询",
            "expected": "筛选控件显示西站、检修；列表仍为6条"
          },
          {
            "order": 3,
            "action": "S03 点击“查询”，核对结果数量和设备行",
            "expected": "显示“共2条”，仅有 DEV-002 和 DEV-005，且不包含 DEV-004"
          }
        ],
        "status": "CONFIRMED"
      }
