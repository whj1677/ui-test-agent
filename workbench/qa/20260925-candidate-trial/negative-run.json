  "frozen_case_content": {
    "external_id": "FRESH-B",
    "title": "同名工单目标选择、详情页签及返回保留筛选",
    "module": "detail",
    "preconditions": "本机合成站；无登录、网络写入、持久化或外部依赖；刷新重置内存状态。只使用绑定入口。",
    "test_data": "以本用例步骤内明确的编号、字段和值为冻结业务预期。",
    "steps": [
      {
        "order": 1,
        "action": "打开绑定正常入口",
        "expected": "工单名称筛选为空；列表共3条工单，编号依次WO-201、WO-202、WO-203"
      },
      {
        "order": 2,
        "action": "工单名称输入巡检任务，点击筛选",
        "expected": "列表恰有2条同名巡检任务：WO-201北区林工、WO-202南区林工，按此顺序显示"
      },
      {
        "order": 3,
        "action": "在编号WO-202且区域南区的行点击查看详情",
        "expected": "进入工单详情；基本信息页签选中；基本信息面板的工单编号WO-202、名称巡检任务、区域南区、负责人林工、优先级高"
      },
      {
        "order": 4,
        "action": "切换到处理记录页签",
        "expected": "处理记录页签选中、基本信息页签未选中；处理记录面板工单编号WO-202、最近处理人赵工、处理结果等待备件"
      },
      {
        "order": 5,
        "action": "点击返回列表",
        "expected": "回到工单列表；工单名称仍为巡检任务；列表仍恰有2条，编号依次WO-201、WO-202，区域分别北区、南区，负责人均为林工"
      }
    ],
    "status": "CONFIRMED"
  },
