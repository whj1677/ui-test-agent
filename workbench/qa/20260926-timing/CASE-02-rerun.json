  "frozen_case_content": {
    "external_id": "CASE-02",
    "title": "登录后按“温控”筛选、异步加载提示、结果顺序与详情抽屉",
    "module": "Kimi合成库存台",
    "preconditions": "已通过“公开合成账号登录”按钮登录，处于 /workspace 工作台页面。",
    "test_data": "合成固定数据，业务真值见Kimi SPEC.md；不是真实业务项目。",
    "steps": [
      {
        "order": 1,
        "action": "在“名称筛选”输入框中输入“温控”，点击“查询”按钮",
        "expected": "出现可见加载提示“正在加载设备列表…”，约 400-600ms 后提示消失且列表刷新；分页指示为“第 1 页 / 共 2 页（共 3 条）”。"
      },
      {
        "order": 2,
        "action": "观察筛选结果第 1 页的行内容与顺序",
        "expected": "第 1 页按编号升序恰好显示 INV-101（温控采集器A）、INV-102（温控采集器B）两行，均展示编号、名称、库存状态与“可选”状态。"
      },
      {
        "order": 3,
        "action": "点击“下一页”翻到第 2 页",
        "expected": "第 2 页仅显示 INV-104（温控采集器C）一行；分页指示为“第 2 页 / 共 2 页（共 3 条）”；整个筛选结果顺序为 INV-101、INV-102、INV-104。"
      },
      {
        "order": 4,
        "action": "点击 INV-104 所在行的“查看详情”按钮",
        "expected": "右侧抽屉打开并先显示“正在加载设备详情…”，约 400-600ms 后显示：编号 INV-104、名称 温控采集器C、型号 TCA-100C、库位 A-01-03、库存状态 在库（充足）、权限提示“当前角色 inspector 可选择该设备”。"
      },
      {
        "order": 5,
        "action": "点击抽屉内的“关闭详情”按钮",
        "expected": "抽屉关闭并返回列表；列表仍保持“温控”筛选结果与当前第 2 页，未发生任何数据修改。"
      }
    ],
    "status": "CONFIRMED"
  },
