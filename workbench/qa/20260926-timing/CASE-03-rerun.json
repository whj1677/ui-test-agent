  "frozen_case_content": {
    "external_id": "CASE-03",
    "title": "无筛选跨页勾选 INV-101 与 INV-104、受限 INV-103 禁用、已选计数保持至第 3 页",
    "module": "Kimi合成库存台",
    "preconditions": "已登录并处于 /workspace 工作台页面；“名称筛选”输入框为空（无筛选）；当前未勾选任何设备。",
    "test_data": "合成固定数据，业务真值见Kimi SPEC.md；不是真实业务项目。",
    "steps": [
      {
        "order": 1,
        "action": "确认筛选框为空后点击“查询”按钮",
        "expected": "加载提示“正在加载设备列表…”出现后消失；第 1 页显示 INV-101、INV-102，分页指示为“第 1 页 / 共 3 页（共 5 条）”。"
      },
      {
        "order": 2,
        "action": "勾选 INV-101 行的复选框",
        "expected": "已选区域显示“已选 1 台：INV-101”。"
      },
      {
        "order": 3,
        "action": "点击“下一页”翻到第 2 页",
        "expected": "第 2 页显示 INV-103（电池巡检仪）、INV-104（温控采集器C）；INV-103 的复选框为禁用状态，行内可见原因文案“该设备为受限资产，当前角色 inspector 无权选择”，可选状态显示“受限不可选”。"
      },
      {
        "order": 4,
        "action": "尝试点击 INV-103 的复选框，然后勾选 INV-104 的复选框",
        "expected": "INV-103 无法被勾选且不计入已选；勾选 INV-104 后已选区域显示“已选 2 台：INV-101、INV-104”。"
      },
      {
        "order": 5,
        "action": "点击“下一页”翻到第 3 页",
        "expected": "第 3 页显示 INV-105（电源模块）；已选区域仍保持“已选 2 台：INV-101、INV-104”，跨页勾选状态保留。"
      },
      {
        "order": 6,
        "action": "点击“上一页”两次返回第 1 页，观察 INV-101 复选框",
        "expected": "INV-101 复选框仍为勾选状态；整个过程无任何保存、提交或真实数据修改入口。"
      }
    ],
    "status": "CONFIRMED"
  },
