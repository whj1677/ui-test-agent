    "snapshot": {
      "content": {
        "external_id": "FRESH-A",
        "title": "自定义区域筛选、空结果与重置",
        "module": "filter",
        "preconditions": "本机合成站；无登录、网络写入、持久化或外部依赖；刷新重置内存状态。只使用绑定入口。",
        "test_data": "以本用例步骤内明确的编号、字段和值为冻结业务预期。",
        "steps": [
          {
            "order": 1,
            "action": "打开绑定正常入口",
            "expected": "设备结果共3条，编号按顺序为P-101、P-102、P-203；区域为全部区域，状态为全部状态，设备关键字为空"
          },
          {
            "order": 2,
            "action": "打开区域自定义下拉，选择南区",
            "expected": "区域显示南区；设备结果仅1条P-203，名称南站泵组、区域南区、状态启用"
          },
          {
            "order": 3,
            "action": "将状态改为停用",
            "expected": "结果数量为0条记录；显示没有符合条件的设备；设备结果表无数据行"
          },
          {
            "order": 4,
            "action": "点击重置",
            "expected": "区域恢复全部区域，状态恢复全部状态，关键字为空；空结果提示不可见；设备结果恢复3条，编号按顺序P-101、P-102、P-203"
          },
          {
            "order": 5,
            "action": "设备关键字输入P-102并点击查询",
            "expected": "设备结果仅1条P-102；该行名称北站备用泵、区域北区、状态停用"
          }
        ],
        "status": "CONFIRMED"
      }
    }
  },
