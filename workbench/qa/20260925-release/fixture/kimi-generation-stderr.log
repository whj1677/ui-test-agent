  ```js
  const $ = (id) => document.getElementById(id);
  const state = { page: 1, totalPages: 1, filter: '', selection: new Map() };

  async function api(path, options = {}) {
    const res = await fetch(path, { headers: { 'Accept': 'application/json' }, ...options });
    let data = null;
    try { data = await res.json(); } catch {}
    return { status: res.status, data };
  }

  function showSessionExpired() {
    const n = $('sessionNotice');
    if (n) n.textContent = '会话已到期，即将返回登录页…';
    setTimeout(() => { location.href = '/login'; }, 1500);
  }

  async function init() {
    const path = location.pathname;
    const { status } = await api('/api/identity');
    if (path === '/login') {
      $('loginView').hidden = false;
      if (status === 200) {
        $('alreadyBox').hidden = false;
        $('loginBtn').hidden = true; // maybe keep but disable? spec: login page shows button; if already authed, show link. Fine.
      }
    } else {
      $('workspaceView').hidden = false;
      const { status: s2, data } = await api('/api/identity');
      if (s2 !== 200) { location.href = '/login'; return; }
      $('whoAccount').textContent = data.account_id;
      $('whoRole').textContent = data.role;
      $('whoExpires').textContent = data.expires_at;
      loadList();
    }
  }
  ```

