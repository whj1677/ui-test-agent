    "preconditions": "独立只读合成数据集恰含BK-001、BK-006、BK-106、XY-006；不读取或修改旧项目数据。查询无分类/状态筛选，从page=1发起，每页5条，编号升序。",
    "test_data": "固定四条记录见dataset；原始输入依次为空串、一个空格+K-00+一个空格、一个空格+K-999+一个空格、空格+Tab+空格。编号或书名包含匹配，不区分大小写，去输入两端空格；空关键词不筛选。",
    "steps": [
      {
        "order": 1,
        "action": "GET查询空关键词page=1，建立字面基线。",
        "expected": "返回四条固定记录BK-001、BK-006、BK-106、XY-006，编号升序；逐记录code/title/category/status符合固定数据；total=4、page=1、page_size=5、pages=1。"
      },
      {
        "order": 2,
        "action": "GET以原样“ K-00 ”查询page=1，不在调用侧trim。",
        "expected": "去除两端空格后按编号包含匹配；只返回BK-001与BK-006，按编号升序且四字段符合固定数据，排除BK-106和XY-006；total=2、page=1、page_size=5、pages=1。"
      },
      {
        "order": 3,
        "action": "GET以原样“ K-999 ”查询page=1，不在调用侧trim。",
        "expected": "HTTP200且可解析JSON，items为空数组、total=0、page=1、page_size=5；无命中是正常业务结果。原来源未定义零结果pages，不能补造其预期。"
      },
      {
        "order": 4,
        "action": "GET以原样空格+Tab+空格查询page=1，独立读回全部数据。",
        "expected": "全空白去除后为空关键词，不筛选；返回原四条记录及原四字段和顺序，数据未变；total=4、page=1、page_size=5、pages=1。"
      }
    ]
